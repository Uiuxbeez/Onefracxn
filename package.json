{
  "name": "onefracxn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test --experimental-test-isolation=none tests/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@vitejs/plugin-react": "^5.0.3",
    "cheerio": "^1.1.2",
    "concurrently": "^9.2.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "vite": "^7.1.7"
  }
}
