# Local development uses embedded PostgreSQL in .local when DATABASE_URL is empty.
DATABASE_URL=
ADMIN_USERNAME=admin
# Set your own password (at least 12 characters). Required on first API start.
ADMIN_PASSWORD=
PORT=3001
FRONTEND_ORIGINS=http://localhost:5173
# Cloudflare build only: public Railway API URL, without trailing slash.
VITE_API_URL=
# Railway: NODE_ENV=production (requires DATABASE_URL and HTTPS frontend origins).
